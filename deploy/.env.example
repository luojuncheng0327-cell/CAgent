# Copy to deploy/.env and replace each placeholder with a unique random value.
# This file has no live credentials. URL-encode passwords used inside a URL.
POSTGRES_PASSWORD=replace-with-random-postgres-password
REDIS_PASSWORD=replace-with-random-redis-password
QDRANT_API_KEY=replace-with-random-qdrant-key
NEO4J_PASSWORD=replace-with-random-neo4j-password

# Configure the gateway/worker separately; shell environment overrides this example.
CAGENT_DATABASE_URL=postgresql+psycopg://cagent:replace-with-random-postgres-password@127.0.0.1:5432/cagent
CAGENT_REDIS_URL=redis://:replace-with-random-redis-password@127.0.0.1:6379/0
CAGENT_QDRANT_URL=http://127.0.0.1:6333
CAGENT_QDRANT_API_KEY=replace-with-random-qdrant-key
CAGENT_NEO4J_URI=bolt://127.0.0.1:7687
CAGENT_NEO4J_USERNAME=neo4j
CAGENT_NEO4J_PASSWORD=replace-with-random-neo4j-password
CAGENT_NEO4J_DATABASE=neo4j
