{
  "name": "hanako",
  "version": "0.450.0",
  "type": "module",
  "description": "HanaAgent - a personal AI agent with memory and soul",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "author": {
    "name": "liliMozi"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "memory",
    "multi-platform",
    "telegram",
    "personal-assistant"
  ],
  "main": "desktop/bootstrap.cjs",
  "bin": {
    "hana": "cli/entry.ts"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme && node scripts/launch.js electron",
    "start:dev": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme && node scripts/launch.js electron-dev",
    "start:vite": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && node scripts/launch.js electron-vite",
    "dev:web": "node scripts/dev-web.js",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:splash": "vite build --config vite.config.splash.ts",
    "build:theme": "vite build --config vite.config.theme.js",
    "build:preload": "vite build --config vite.config.preload.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "cli": "node scripts/launch.js cli",
    "server": "node scripts/launch.js server",
    "build:main": "vite build --config vite.config.main.js",
    "build:computer-use-helper": "node scripts/build-computer-use-helper.mjs",
    "build:windows-sandbox-helper": "node scripts/build-windows-sandbox-helper.mjs",
    "build:client": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme",
    "build:shell": "node scripts/build-shell.mjs",
    "build:packages": "npm run build --workspaces --if-present",
    "generate:windows-icon": "node scripts/generate-windows-icon.cjs",
    "pack": "npm run build:computer-use-helper && npm run build:client && npm run build:server && npm run verify:seed-kit && electron-builder --dir",
    "install:local": "npm run pack && rm -rf /Applications/HanaAgent.app /Applications/Hanako.app && cp -R dist/mac-arm64/HanaAgent.app /Applications/ && printf 'provider: github\\nowner: liliMozi\\nrepo: openhanako\\n' > /Applications/HanaAgent.app/Contents/Resources/app-update.yml && node scripts/sign-local.cjs",
    "dist": "npm run build:computer-use-helper && npm run build:client && npm run build:server && npm run verify:seed-kit && electron-builder --mac dmg",
    "dist:win": "npm run build:computer-use-helper && npm run build:windows-sandbox-helper && npm run generate:windows-icon && npm run build:client && npm run build:server && npm run verify:seed-kit && npm run pack:server:standalone && npm run verify:standalone:server && electron-builder --win nsis",
    "dist:linux": "npm run build:client && npm run build:server && npm run verify:seed-kit && electron-builder --linux AppImage deb",
    "verify:seed-kit": "node scripts/verify-seed-kit.mjs",
    "pack:server:standalone": "node scripts/build-standalone-server-artifact.mjs x64",
    "verify:standalone:server": "node scripts/verify-standalone-server-artifact.mjs x64 --smoke",
    "test": "vitest run --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "build:server": "node scripts/build-server.mjs",
    "build:server:open": "node scripts/build-server-open.mjs",
    "smoke:server:open": "node scripts/smoke-open-server.mjs",
    "export:open": "node scripts/export-open-tree.mjs",
    "rehearse:open": "node scripts/rehearse-open-export.mjs",
    "lint": "eslint .",
    "lint:boundary": "node scripts/lint-open-boundary.mjs",
    "test:watch": "vitest --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "test:core": "vitest run --maxWorkers=2 tests/agent-cost-policy.test.ts tests/task-registry-lifecycle.test.ts tests/task-registry.test.ts tests/session-execution-registry.test.ts tests/session-compaction-runtime.test.ts tests/output-length-contract.test.ts tests/llm-transport-reliability.test.ts tests/llm-client-provider-compat.test.ts tests/llm-client-usage-ledger.test.ts tests/memory-reliability.test.ts tests/memory-compile-contracts.test.ts tests/memory-prompt-boundaries.test.ts tests/memory-search-channel-scope.test.ts tests/telegram-adapter-media.test.ts tests/feishu-adapter.test.ts tests/feishu-sdk-contract.test.ts tests/backend-boundaries.test.ts tests/mcp-stdio-client.test.ts tests/mcp-http-client.test.ts tests/mcp-runtime.test.ts tests/mcp-reconnect.test.ts tests/mcp-oauth.test.ts tests/session-teardown.test.ts tests/ws-protocol.test.ts tests/llm-utils-error-cause.test.ts tests/agent-description.test.ts tests/slash-commands/rc-summary.test.ts tests/workflow-run-limits.test.ts tests/workflow-concurrency.test.ts tests/workflow-integration.test.ts tests/workflow-tool.test.ts tests/workflow-host-api.test.ts tests/server-auth.test.ts tests/ws-auth-ticket.test.ts",
    "smoke:core": "node scripts/smoke-cagent.mjs",
    "postinstall": "node scripts/patch-pi-sdk.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "6.43.0",
    "@earendil-works/pi-agent-core": "0.80.3",
    "@earendil-works/pi-ai": "0.80.3",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@firecrawl/anydoc": "0.1.2",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@node-rs/jieba": "2.0.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tiptap/core": "^3.22.0",
    "@tiptap/extension-bold": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "diff": "8.0.4",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "hono": "^4.12.9",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.0.2",
    "katex": "^0.16.39",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.10.1",
    "motion": "12.40.0",
    "node-pty": "1.1.0",
    "node-telegram-bot-api": "^0.67.0",
    "proxy-agent": "6.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typebox": "1.1.38",
    "undici": "7.24.7",
    "unpdf": "1.6.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/nft": "^1.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "42.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pngjs": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.hanako.app",
    "productName": "HanaAgent",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./scripts/fix-modules.cjs",
    "extraMetadata": {
      "main": "desktop/bootstrap.cjs"
    },
    "files": [
      "desktop/main.bundle.cjs",
      "desktop/bootstrap.cjs",
      "desktop/src/office-pdf-helper.cjs",
      "desktop/src/office-pdf-fonts.cjs",
      "desktop/src/shared/launch-integrity.cjs",
      "desktop/src/shared/windows-system-ca.cjs",
      "shared/hana-runtime-paths.cjs",
      "desktop/preload.bundle.cjs",
      "desktop/dist-splash/**",
      "desktop/src/**/*.{html,icns,ico,png,svg,json}",
      "desktop/src/assets/**",
      "package.json",
      "release-digest.v1.json",
      "release-digest.v2.json",
      "!packages/**",
      "!**/node_modules/**",
      "node_modules/ws/**"
    ],
    "extraResources": [
      {
        "from": "dist-server-artifact/${os}-${arch}/",
        "to": "seed/"
      },
      {
        "from": "desktop/src/screenshot-themes/",
        "to": "screenshot-themes/"
      },
      {
        "from": "desktop/src/assets/",
        "to": "assets/"
      }
    ],
    "afterSign": "./scripts/notarize.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/src/icon.icns",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "dist-computer-use/mac-${arch}/",
          "to": "computer-use/macos/"
        }
      ]
    },
    "dmg": {
      "title": "HanaAgent",
      "contents": [
        {
          "x": 180,
          "y": 220
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitee.com/luo-juncheng666/cagent/raw/master/updates/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/src/icon.ico",
      "executableName": "HanaAgent",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "vendor/mingit",
          "to": "git"
        },
        {
          "from": "dist-sandbox/win-${arch}/",
          "to": "sandbox/windows/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "HanaAgent",
      "include": "build/installer.nsh",
      "installerIcon": "desktop/src/icon.ico",
      "uninstallerIcon": "desktop/src/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "liliMozi <liliMozi@users.noreply.github.com>",
      "category": "Utility",
      "icon": "desktop/src/icon.png",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    }
  }
}
