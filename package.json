{
  "name": "cagent-independent",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "Independently implemented personal AI workspace",
  "author": "呈平安",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "spec": "node scripts/render-spec.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "build": "vite build && node scripts/build-desktop.mjs",
    "dev": "node src/server/main.ts",
    "start": "electron .",
    "setup:desktop": "node node_modules/electron/install.js",
    "cli": "node src/cli.ts",
    "check:independent": "node scripts/check-independent.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:independent",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "markdown-it": "14.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/markdown-it": "14.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "esbuild": "0.27.4",
    "electron": "44.4.5",
    "playwright": "1.58.2"
  },
  "packageManager": "pnpm@11.19.0"
}
