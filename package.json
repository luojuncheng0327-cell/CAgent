{
  "name": "cagent-independent",
  "version": "0.1.0",
  "private": true,
  "description": "Independently implemented personal AI workspace",
  "author": "呈平安",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "spec": "node scripts/render-spec.mjs",
    "status": "node scripts/update-status.mjs",
    "check:status": "node scripts/update-status.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "build": "vite build && node scripts/build-desktop.mjs",
    "package:win": "pnpm run build && electron-builder --win portable --x64 --publish never",
    "dev": "node src/server/main.ts",
    "start": "electron .",
    "setup:desktop": "node node_modules/electron/install.js",
    "cli": "node src/cli.ts",
    "check:independent": "node scripts/check-independent.mjs",
    "check:similarity": "node scripts/check-similarity.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && pnpm run check:status && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:independent && pnpm run check:similarity",
    "test:desktop": "node tests/desktop-smoke.mjs && node tests/desktop-onboarding.mjs && node tests/desktop-p1-p2.mjs && node tests/desktop-appearance.mjs && node tests/desktop-layout.mjs && node tests/desktop-menus.mjs && node tests/desktop-documents.mjs && node tests/desktop-navigation.mjs && node tests/desktop-directories.mjs && node tests/desktop-runtime.mjs && node tests/desktop-file-drafts.mjs && node tests/desktop-file-operations.mjs"
  },
  "dependencies": {
    "markdown-it": "14.1.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.4.5",
    "electron-builder": "26.8.1",
    "esbuild": "0.27.4",
    "playwright": "1.58.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "packageManager": "pnpm@11.19.0",
  "build": {
    "appId": "com.chengpingan.cagent.independent",
    "productName": "CAgent",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/ui/fonts/licenses",
        "to": "licenses/fonts"
      },
      {
        "from": "docs/DEPENDENCIES.md",
        "to": "licenses/DEPENDENCIES.md"
      },
      {
        "from": "src/ui/assets/README.md",
        "to": "licenses/IMAGE-SOURCE.md"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "src/ui/assets/assistant-portrait.png",
      "executableName": "CAgent",
      "artifactName": "CAgent-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
